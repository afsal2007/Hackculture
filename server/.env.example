# ==============================================================================
# Research Agent Arena - Backend Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to .env: `cp .env.example .env`
# 2. Replace placeholder values with your actual configuration.
# 3. DO NOT commit .env with real credentials into version control.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration (MongoDB)
# Local MongoDB:
# MONGODB_URI=mongodb://localhost:27017/research_agent_arena
# MongoDB Atlas:
# MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/research_agent_arena?retryWrites=true&w=majority
MONGODB_URI=mongodb://localhost:27017/research_agent_arena

# Client Configuration (Allowed Frontend Origin for CORS)
CLIENT_URL=http://localhost:5173


